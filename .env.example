# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
AI_SPEND_ACCESS_TOKEN=replace-with-your-own-random-token-at-least-32-chars
# For LAN access, use NAS actual PRIVATE address, such as 192.168.1.20.
# Keep 127.0.0.1 to bind only to the NAS itself.
AI_SPEND_BIND_IP=127.0.0.1
TZ=Asia/Shanghai
